# Node modules
node_modules/

# Python virtual environment
venv/

# Django migration files
**/migrations/*
!**/migrations/__init__.py

# Other unnecessary files
*.log
*.pyc
__pycache__/

# Environment / secrets — NEVER commit
backend/.env
.env

# Uploaded raw files (can be large)
workspace/raw/*
workspace/wiki/.git/

# Next.js build output
frontend/.next/