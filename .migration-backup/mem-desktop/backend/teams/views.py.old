@api_view(["GET", "PUT", "POST"])
@permission_classes([IsAuthenticated])
def team_notifications(request, team_id):
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    membership = get_team_membership(request, team)
    if not membership:
        return Response({"error": "Access denied"}, status=status.HTTP_403_FORBIDDEN)

    if request.method == "GET":
        unread_only = request.query_params.get("unread")
        notifications = team.notifications.filter(user=request.user)
        if unread_only:
            notifications = notifications.filter(is_read=False)
        return Response(TeamNotificationSerializer(notifications, many=True).data)

    elif request.method == "PUT":
        notification_id = request.data.get("notification_id")
        notification = team.notifications.filter(
            id=notification_id, user=request.user
        ).first()
        if notification:
            notification.is_read = True
            notification.save()
        return Response({"marked_read": True})

    elif request.method == "POST":
        if membership.role not in ["owner"]:
            return Response(
                {"error": "Only owners can send notifications"},
                status=status.HTTP_403_FORBIDDEN,
            )
        notification_type = request.data.get("notification_type", "announcement")
        title = request.data.get("title", "")
        message = request.data.get("message", "")
        link = request.data.get("link", "")

        for m in team.memberships.filter(is_active=True):
            TeamNotification.objects.create(
                team=team,
                user=m.user,
                notification_type=notification_type,
                title=title,
                message=message,
                link=link,
            )
        return Response({"sent": True})


@api_view(["GET", "POST"])
@permission_classes([IsAuthenticated])
def team_conflicts(request, team_id):
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    membership = get_team_membership(request, team)
    if not membership:
        return Response({"error": "Access denied"}, status=status.HTTP_403_FORBIDDEN)

    if request.method == "GET":
        status_filter = request.query_params.get("status")
        conflicts = team.conflicts.all()
        if status_filter:
            conflicts = conflicts.filter(status=status_filter)
        return Response(TeamKnowledgeConflictSerializer(conflicts, many=True).data)

    elif request.method == "POST":
        if membership.role not in ["owner", "editor"]:
            return Response(
                {"error": "Only editors can create conflicts"},
                status=status.HTTP_403_FORBIDDEN,
            )
        conflict = TeamKnowledgeConflict.objects.create(
            team=team,
            node_a_type=request.data.get("node_a_type"),
            node_a_id=request.data.get("node_a_id"),
            node_b_type=request.data.get("node_b_type"),
            node_b_id=request.data.get("node_b_id"),
            description=request.data.get("description", ""),
        )
        return Response(TeamKnowledgeConflictSerializer(conflict).data, status=status.HTTP_201_CREATED)


@api_view(["POST"])
@permission_classes([IsAuthenticated])
def resolve_conflict(request, team_id, conflict_id):
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    membership = get_team_membership(request, team)
    if not membership or membership.role not in ["owner", "editor"]:
        return Response({"error": "Only editors can resolve conflicts"}, status=status.HTTP_403_FORBIDDEN)

    try:
        conflict = team.conflicts.get(id=conflict_id)
    except TeamKnowledgeConflict.DoesNotExist:
        return Response({"error": "Conflict not found"}, status=status.HTTP_404_NOT_FOUND)

    conflict.status = "resolved"
    conflict.resolution = request.data.get("resolution", "")
    conflict.resolved_by = request.user
    conflict.resolved_at = timezone.now()
    conflict.save()

    return Response({"resolved": True})


@api_view(["GET"])
@permission_classes([IsAuthenticated])
def team_audit(request, team_id):
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    membership = get_team_membership(request, team)
    if not membership or membership.role != "owner":
        return Response({"error": "Only owners can view audit logs"}, status=status.HTTP_403_FORBIDDEN)

    limit = int(request.query_params.get("limit", 100))
    logs = TeamAuditLogSerializer(team.audit_logs.all()[:limit], many=True).data
    return Response(logs)


@api_view(["POST"])
@permission_classes([IsAuthenticated])
def share_to_team(request, team_id):
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    membership = get_team_membership(request, team)
    if not membership or membership.role not in ["owner", "editor"]:
        return Response({"error": "Only editors can share to team"}, status=status.HTTP_403_FORBIDDEN)

    page_id = request.data.get("page_id")
    from knowledge.models import WorkspacePage

    try:
        original_page = WorkspacePage.objects.get(id=page_id)
    except WorkspacePage.DoesNotExist:
        return Response({"error": "Page not found"}, status=status.HTTP_404_NOT_FOUND)

    team_page = TeamPage.objects.create(
        team=team,
        original_page=original_page,
        title=original_page.title,
        slug=original_page.slug,
        icon=original_page.icon,
        cover=original_page.cover,
        content={"copied_from": str(original_page.id)},
        page_type="standard",
        publish_state="draft",
        created_by=request.user,
    )

    TeamActivity.objects.create(
        team=team,
        user=request.user,
        action="page_shared",
        target_type="page",
        target_id=team_page.id,
        metadata={"original_page_id": str(original_page.id)},
    )

    return Response(TeamPageSerializer(team_page).data, status=status.HTTP_201_CREATED)


@api_view(["POST"])
@permission_classes([IsAuthenticated])
def fork_to_personal(request, team_id):
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    membership = get_team_membership(request, team)
    if not membership:
        return Response({"error": "Access denied"}, status=status.HTTP_403_FORBIDDEN)

    page_id = request.data.get("page_id")
    from knowledge.models import WorkspacePage

    try:
        team_page = team.pages.get(id=page_id)
    except TeamPage.DoesNotExist:
        return Response({"error": "Team page not found"}, status=status.HTTP_404_NOT_FOUND)

    personal_page = WorkspacePage.objects.create(
        slug=f"{team.slug}-{team_page.slug}",
        title=team_page.title,
        icon=team_page.icon,
        cover=team_page.cover,
        description=team_page.description,
        tags=team_page.tags,
        last_edited_by=request.user.username,
    )

    TeamActivity.objects.create(
        team=team,
        user=request.user,
        action="page_forked",
        target_type="page",
        target_id=team_page.id,
        metadata={"personal_page_id": str(personal_page.id)},
    )

    return Response({
        "id": str(personal_page.id),
        "slug": personal_page.slug,
        "title": personal_page.title,
        "created_at": personal_page.created_at.isoformat(),
    }, status=status.HTTP_201_CREATED)


@api_view(["GET"])
@permission_classes([IsAuthenticated])
def workspace_switcher(request):
    if not request.user.is_authenticated:
        return Response({"personal": None, "teams": []})

    memberships = TeamMembership.objects.filter(
        user=request.user, is_active=True
    ).select_related("team")

    teams_data = []
    for m in memberships:
        team_data = TeamSerializer(m.team, context={"request": request}).data
        team_data["my_role"] = m.role
        teams_data.append(team_data)

    return Response({
        "personal": {"id": str(request.user.id), "name": "Personal"},
        "teams": teams_data,
    })


@api_view(["POST"])
@permission_classes([IsAuthenticated])
def transfer_ownership(request, team_id):
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    current_owner = TeamMembership.objects.filter(team=team, user=request.user, role="owner").first()
    if not current_owner:
        return Response({"error": "Only owners can transfer ownership"}, status=status.HTTP_403_FORBIDDEN)

    new_owner_id = request.data.get("new_owner_id")
    try:
        new_owner = TeamMembership.objects.get(team=team, user_id=new_owner_id)
    except TeamMembership.DoesNotExist:
        return Response({"error": "User is not a member"}, status=status.HTTP_400_BAD_REQUEST)

    current_owner.role = "editor"
    current_owner.save()

    new_owner.role = "owner"
    new_owner.save()

    TeamAuditLog.objects.create(
        team=team,
        user=request.user,
        action="ownership_transferred",
        target_type="user",
        target_id=new_owner_id,
    )

    return Response({"transferred": True})


@api_view(["GET"])
@permission_classes([IsAuthenticated])
def search_team(request, team_id):
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    membership = get_team_membership(request, team)
    if not membership:
        return Response({"error": "Access denied"}, status=status.HTTP_403_FORBIDDEN)

    query = request.query_params.get("q", "")
    if not query:
        return Response({"results": []})

    pages = team.pages.filter(
        Q(title__icontains=query) | Q(description__icontains=query)
    )[:20]

    return Response({
        "pages": TeamPageSerializer(pages, many=True).data,
    })


@api_view(["POST"])
@permission_classes([IsAuthenticated])
def team_ai_chat(request, team_id):
    """Chat with team AI using team knowledge context."""
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    membership = get_team_membership(request, team)
    if not membership:
        return Response({"error": "Access denied"}, status=status.HTTP_403_FORBIDDEN)

    question = request.data.get("question", "").strip()
    if not question:
        return Response({"error": "question is required"}, status=status.HTTP_400_BAD_REQUEST)

    from .ai_integration import team_chat_processor
    from ingest.ai_client import MemosAIClient

    ai_client = MemosAIClient()
    result = team_chat_processor(team, request.user, question, ai_client)

    return Response(result)