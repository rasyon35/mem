    TeamNotificationSerializer,
    TeamAuditLogSerializer,
    TeamKnowledgeConflictSerializer,
)


def get_team_membership(request, team):
    if not request.user.is_authenticated:
        return None
    return TeamMembership.objects.filter(team=team, user=request.user, is_active=True).first()


def require_role(*allowed_roles):
    def decorator(view_func):
        def wrapper(request, team_id, *args, **kwargs):
            try:
                team = Team.objects.get(id=team_id)
                membership = get_team_membership(request, team)
                if not membership:
                    return Response(
                        {"error": "You are not a member of this team"},
                        status=status.HTTP_403_FORBIDDEN,
                    )
                if membership.role not in allowed_roles and "owner" not in allowed_roles:
                    if membership.role != "owner":
                        return Response(
                            {"error": "Insufficient permissions"},
                            status=status.HTTP_403_FORBIDDEN,
                        )
                return view_func(request, team, membership, *args, **kwargs)
            except Team.DoesNotExist:
                return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)
        return wrapper
    return decorator


@api_view(["GET", "POST"])
@permission_classes([IsAuthenticated])
def team_list_create(request):
    if request.method == "GET":
        memberships = TeamMembership.objects.filter(
            user=request.user, is_active=True
        ).select_related("team")
        teams = [m.team for m in memberships]
        serializer = TeamSerializer(teams, many=True, context={"request": request})
        return Response(serializer.data)

    elif request.method == "POST":
        serializer = TeamCreateSerializer(data=request.data, context={"request": request})
        if serializer.is_valid():
            team = serializer.save()
            TeamActivity.objects.create(
                team=team,
                user=request.user,
                action="team_created",
                target_type="team",
                target_id=team.id,
            )
            return Response(TeamSerializer(team, context={"request": request}).data, status=status.HTTP_201_CREATED)
        return Response(serializer.errors, status=status.HTTP_400_BAD_REQUEST)


@api_view(["GET", "PUT", "DELETE"])
@permission_classes([IsAuthenticated])
def team_detail(request, team_id):
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    membership = get_team_membership(request, team)
    if not membership:
        return Response({"error": "Access denied"}, status=status.HTTP_403_FORBIDDEN)

    if request.method == "GET":
        return Response(TeamSerializer(team, context={"request": request}).data)

    elif request.method == "PUT":
        if membership.role != "owner":
            return Response({"error": "Only owners can edit team"}, status=status.HTTP_403_FORBIDDEN)
        serializer = TeamSerializer(team, data=request.data, partial=True, context={"request": request})
        if serializer.is_valid():
            serializer.save()
            return Response(serializer.data)
        return Response(serializer.errors, status=status.HTTP_400_BAD_REQUEST)

    elif request.method == "DELETE":
        if membership.role != "owner":
            return Response({"error": "Only owners can delete team"}, status=status.HTTP_403_FORBIDDEN)
        team.is_archived = True
        team.save()
        return Response({"deleted": True})


@api_view(["GET"])
@permission_classes([IsAuthenticated])
def team_home(request, team_id):
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    membership = get_team_membership(request, team)
    if not membership:
        return Response({"error": "Access denied"}, status=status.HTTP_403_FORBIDDEN)

    membership.last_accessed_at = timezone.now()
    membership.save()

    members = TeamMembershipSerializer(
        team.memberships.filter(is_active=True), many=True
    ).data

    recent_pages = TeamPageSerializer(
        team.pages.filter(is_archived=False).order_by("-updated_at")[:10], many=True
    ).data

    recent_activity = TeamActivitySerializer(
        team.activities.all()[:20], many=True
    ).data

    try:
        onboarding = team.onboarding
        onboarding_data = TeamOnboardingSerializer(onboarding).data
    except TeamOnboarding.DoesNotExist:
        onboarding_data = None

    return Response({
        "team": TeamSerializer(team, context={"request": request}).data,
        "members": members,
        "recent_pages": recent_pages,
        "recent_activity": recent_activity,
        "onboarding": onboarding_data,
    })


@api_view(["GET"])
@permission_classes([IsAuthenticated])
def my_teams(request):
    memberships = TeamMembership.objects.filter(
        user=request.user, is_active=True
    ).select_related("team")
    teams_data = []
    for m in memberships:
        team_data = TeamSerializer(m.team, context={"request": request}).data
        team_data["my_role"] = m.role
        teams_data.append(team_data)
    return Response(teams_data)


@api_view(["GET", "POST"])
@permission_classes([IsAuthenticated])
def team_members(request, team_id):
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    membership = get_team_membership(request, team)
    if not membership:
        return Response({"error": "Access denied"}, status=status.HTTP_403_FORBIDDEN)

    if request.method == "GET":
        members = TeamMembershipSerializer(
            team.memberships.filter(is_active=True), many=True
        ).data
        return Response(members)

    elif request.method == "POST":
        if membership.role not in ["owner", "editor"]:
            return Response(
                {"error": "Only owners and editors can add members"},
                status=status.HTTP_403_FORBIDDEN,
            )
        email = request.data.get("email")
        user_id = request.data.get("user_id")
        role = request.data.get("role", "viewer")
        if email:
            invite = TeamInvite.objects.create(
                team=team,
                invited_by=request.user,
                email=email,
                role=role,
            )
            return Response(TeamInviteSerializer(invite).data, status=status.HTTP_201_CREATED)
        return Response({"error": "email or user_id required"}, status=status.HTTP_400_BAD_REQUEST)


@api_view(["POST"])
@permission_classes([IsAuthenticated])
def remove_member(request, team_id):
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    membership = get_team_membership(request, team)
    if not membership or membership.role != "owner":
        return Response({"error": "Only owners can remove members"}, status=status.HTTP_403_FORBIDDEN)

    member_id = request.data.get("member_id")
    try:
        member = TeamMembership.objects.get(id=member_id, team=team)
    except TeamMembership.DoesNotExist:
        return Response({"error": "Member not found"}, status=status.HTTP_404_NOT_FOUND)

    if member.role == "owner":
        return Response({"error": "Cannot remove owner"}, status=status.HTTP_400_BAD_REQUEST)

    TeamBranch.objects.filter(
        team=team, creator=member.user, status="draft"
    ).update(status="orphaned")

    TeamAuditLog.objects.create(
        team=team,
        user=request.user,
        action="member_removed",
        target_type="user",
        target_id=member.user_id,
    )

    member.delete()
    return Response({"removed": True})


@api_view(["POST"])
@permission_classes([IsAuthenticated])
def create_invite(request, team_id):
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    membership = get_team_membership(request, team)
    if not membership or membership.role != "owner":
        return Response({"error": "Only owners can create invites"}, status=status.HTTP_403_FORBIDDEN)

    invite = TeamInvite.objects.create(
        team=team,
        invited_by=request.user,
        role=request.data.get("role", "viewer"),
        max_uses=request.data.get("max_uses", 1),
        expires_at=request.data.get("expires_at"),
    )
    return Response(TeamInviteSerializer(invite).data, status=status.HTTP_201_CREATED)


@api_view(["GET"])
@permission_classes([AllowAny])
def accept_invite(request, code):
    try:
        invite = TeamInvite.objects.get(code=code)
    except TeamInvite.DoesNotExist:
        return Response({"error": "Invalid invite code"}, status=status.HTTP_404_NOT_FOUND)

    if not invite.is_valid:
        return Response({"error": "Invite expired or used"}, status=status.HTTP_400_BAD_REQUEST)

    team = invite.team
    serializer = TeamSerializer(team)
    return Response({
        "team": serializer.data,
        "invite": TeamInviteSerializer(invite).data,
    })


@api_view(["POST"])
@permission_classes([IsAuthenticated])
def join_team(request, team_id):
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    code = request.data.get("code", "")
    if code:
        try:
            invite = TeamInvite.objects.get(team=team, code=code)
            if not invite.is_valid:
                return Response({"error": "Invalid invite"}, status=status.HTTP_400_BAD_REQUEST)
            invite.uses += 1
            invite.save()
            role = invite.role
        except TeamInvite.DoesNotExist:
            return Response({"error": "Invalid invite code"}, status=status.HTTP_400_BAD_REQUEST)
    else:
        if team.visibility == "private":
            return Response({"error": "This team requires an invite"}, status=status.HTTP_403_FORBIDDEN)
        role = "viewer"

    membership, created = TeamMembership.objects.get_or_create(
        team=team, user=request.user, defaults={"role": role}
    )
    if not created and membership.is_active:
        return Response({"error": "Already a member"}, status=status.HTTP_400_BAD_REQUEST)

    membership.is_active = True
    membership.role = role
    membership.save()

    TeamActivity.objects.create(
        team=team,
        user=request.user,
        action="member_joined",
        target_type="user",
        target_id=request.user.id,
    )

    return Response(TeamMembershipSerializer(membership).data)


@api_view(["GET", "POST"])
@permission_classes([IsAuthenticated])
def team_pages(request, team_id):
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    membership = get_team_membership(request, team)
    if not membership:
        return Response({"error": "Access denied"}, status=status.HTTP_403_FORBIDDEN)

    if request.method == "GET":
        page_type = request.query_params.get("type")
        archived = request.query_params.get("archived")
        pinned = request.query_params.get("pinned")

        pages = team.pages.all()
        if page_type:
            pages = pages.filter(page_type=page_type)
        if archived:
            pages = pages.filter(is_archived=archived.lower() == "true")
        else:
            pages = pages.filter(is_archived=False)
        if pinned:
            pages = pages.filter(is_pinned=pinned.lower() == "true")

        return Response(TeamPageSerializer(pages, many=True).data)

    elif request.method == "POST":
        if membership.role not in ["owner", "editor"]:
            return Response(
                {"error": "Only owners and editors can create pages"},
                status=status.HTTP_403_FORBIDDEN,
            )
        page = TeamPage.objects.create(
            team=team,
            title=request.data.get("title", "Untitled"),
            slug=request.data.get("slug", ""),
            content=request.data.get("content", {}),
            page_type=request.data.get("page_type", "standard"),
            publish_state=request.data.get("publish_state", "draft"),
            created_by=request.user,
        )
        TeamActivity.objects.create(
            team=team,
            user=request.user,
            action="page_created",
            target_type="page",
            target_id=page.id,
            metadata={"title": page.title},
        )
        return Response(TeamPageSerializer(page).data, status=status.HTTP_201_CREATED)


@api_view(["GET", "PUT", "DELETE"])
@permission_classes([IsAuthenticated])
def team_page_detail(request, team_id, page_id):
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    membership = get_team_membership(request, team)
    if not membership:
        return Response({"error": "Access denied"}, status=status.HTTP_403_FORBIDDEN)

    try:
        page = team.pages.get(id=page_id)
    except TeamPage.DoesNotExist:
        return Response({"error": "Page not found"}, status=status.HTTP_404_NOT_FOUND)

    if request.method == "GET":
        return Response(TeamPageSerializer(page).data)

    elif request.method == "PUT":
        if membership.role not in ["owner", "editor"]:
            return Response(
                {"error": "Only owners and editors can edit pages"},
                status=status.HTTP_403_FORBIDDEN,
            )
        if page.current_editor and page.current_editor != request.user:
            return Response(
                {"error": "Page is being edited by another user"},
                status=status.HTTP_409_CONFLICT,
            )

        old_content = page.content
        TeamPageRevision.objects.create(
            page=page,
            snapshot_json=old_content,
            summary=request.data.get("summary", ""),
            author=request.user,
        )

        serializer = TeamPageSerializer(page, data=request.data, partial=True)
        if serializer.is_valid():
            page = serializer.save()
            page.version += 1
            page.current_editor = None
            page.save()

            TeamActivity.objects.create(
                team=team,
                user=request.user,
                action="page_edited",
                target_type="page",
                target_id=page.id,
                metadata={"title": page.title},
            )
            return Response(TeamPageSerializer(page).data)
        return Response(serializer.errors, status=status.HTTP_400_BAD_REQUEST)

    elif request.method == "DELETE":
        if membership.role not in ["owner", "editor"]:
            return Response(
                {"error": "Only owners and editors can delete pages"},
                status=status.HTTP_403_FORBIDDEN,
            )
        page.delete()
        return Response({"deleted": True})


@api_view(["POST"])
@permission_classes([IsAuthenticated])
def lock_page(request, team_id, page_id):
    try:
        page = TeamPage.objects.get(id=page_id, team_id=team_id)
    except TeamPage.DoesNotExist:
        return Response({"error": "Page not found"}, status=status.HTTP_404_NOT_FOUND)

    team = page.team
    membership = get_team_membership(request, team)
    if not membership or membership.role not in ["owner", "editor"]:
        return Response({"error": "Only editors can lock pages"}, status=status.HTTP_403_FORBIDDEN)

    page.current_editor = request.user
    page.save()
    return Response({"locked": True, "user": request.user.username})


@api_view(["POST"])
@permission_classes([IsAuthenticated])
def unlock_page(request, team_id, page_id):
    try:
        page = TeamPage.objects.get(id=page_id, team_id=team_id)
    except TeamPage.DoesNotExist:
        return Response({"error": "Page not found"}, status=status.HTTP_404_NOT_FOUND)

    team = page.team
    membership = get_team_membership(request, team)
    if not membership:
        return Response({"error": "Access denied"}, status=status.HTTP_403_FORBIDDEN)

    if page.current_editor and page.current_editor != request.user:
        return Response({"error": "Page is locked by another user"}, status=status.HTTP_409_CONFLICT)

    page.current_editor = None
    page.save()
    return Response({"unlocked": True})


@api_view(["GET", "POST"])
@permission_classes([IsAuthenticated])
def team_graph(request, team_id):
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    membership = get_team_membership(request, team)
    if not membership:
        return Response({"error": "Access denied"}, status=status.HTTP_403_FORBIDDEN)

    if request.method == "GET":
        nodes = TeamGraphNodeSerializer(
            team.graph_nodes.filter(is_active=True), many=True
        ).data
        links = TeamGraphLinkSerializer(
            team.graph_links.all(), many=True
        ).data
        return Response({"nodes": nodes, "links": links})

    elif request.method == "POST":
        if membership.role not in ["owner", "editor"]:
            return Response(
                {"error": "Only owners and editors can update graph"},
                status=status.HTTP_403_FORBIDDEN,
            )
        node_data = request.data.get("node")
        link_data = request.data.get("link")

        node = None
        if node_data:
            node, _ = TeamGraphNode.objects.update_or_create(
                team=team,
                entity_type=node_data.get("entity_type"),
                entity_id=node_data.get("entity_id"),
                defaults={
                    "label": node_data.get("label", ""),
                    "description": node_data.get("description", ""),
                    "metadata": node_data.get("metadata", {}),
                    "x": node_data.get("x", 0),
                    "y": node_data.get("y", 0),
                },
            )
        if link_data:
            link = TeamGraphLink.objects.create(
                team=team,
                source=node,
                target_id=link_data.get("target_id"),
                label=link_data.get("label", ""),
                link_type=link_data.get("link_type", "reference"),
            )
        return Response({"saved": True})


@api_view(["GET", "POST"])
@permission_classes([IsAuthenticated])
def team_branches(request, team_id):
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    membership = get_team_membership(request, team)
    if not membership:
        return Response({"error": "Access denied"}, status=status.HTTP_403_FORBIDDEN)

    if request.method == "GET":
        status_filter = request.query_params.get("status")
        branches = team.branches.all()
        if status_filter:
            branches = branches.filter(status=status_filter)
        return Response(TeamBranchSerializer(branches, many=True).data)

    elif request.method == "POST":
        if membership.role not in ["owner", "editor"]:
            return Response(
                {"error": "Only owners and editors can create branches"},
                status=status.HTTP_403_FORBIDDEN,
            )
        branch = TeamBranch.objects.create(
            team=team,
            title=request.data.get("title", "Untitled Draft"),
            content=request.data.get("content", {}),
            status="draft",
            creator=request.user,
        )
        return Response(TeamBranchSerializer(branch).data, status=status.HTTP_201_CREATED)


@api_view(["POST"])
@permission_classes([IsAuthenticated])
def branch_action(request, team_id, branch_id):
    try:
        team = Team.objects.get(id=team_id)
    except Team.DoesNotExist:
        return Response({"error": "Team not found"}, status=status.HTTP_404_NOT_FOUND)

    membership = get_team_membership(request, team)
    if not membership:
        return Response({"error": "Access denied"}, status=status.HTTP_403_FORBIDDEN)

    try:
        branch = team.branches.get(id=branch_id)
    except TeamBranch.DoesNotExist:
        return Response({"error": "Branch not found"}, status=status.HTTP_404_NOT_FOUND)

    action = request.data.get("action")

    if action == "submit_review":
        branch.status = "in_review"
        branch.save()
    elif action == "approve":
        if membership.role not in ["owner", "editor"]:
            return Response(
                {"error": "Only editors can approve"},
                status=status.HTTP_403_FORBIDDEN,
            )
        branch.status = "approved"
        branch.save()
    elif action == "merge":
        if membership.role not in ["owner", "editor"]:
            return Response(
                {"error": "Only editors can merge"},
                status=status.HTTP_403_FORBIDDEN,
            )
        branch.status = "merged"
        branch.save()
    elif action == "close":
        branch.status = "closed"
        branch.save()

    return Response({"action": action, "status": branch.status})


@api_view(["GET", "POST"])
@permission_classes([IsAuthenticated])
